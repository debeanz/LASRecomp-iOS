<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The game's memory is a 12.5 GB address window at 32 GB (runtime/rt.h GUEST_ORIGIN): it needs the larger address
     space, and the game itself up to ~3 GB of memory. Sideloading tools keep these when they re-sign the app. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
